# 서버
PORT=3000
AUTH_ORIGIN=https://auth.bini59.dev
COOKIE_DOMAIN=.bini59.dev
STATIC_ORIGIN=https://static.bini59.dev
PROFILE_STORAGE_DIR=/var/lib/321-auth/profile
SESSION_TTL_SECONDS=1209600
ADMIN_SESSION_TTL_SECONDS=28800
# Generate locally; never commit a plaintext password or a real hash:
# node -e "const {randomBytes,scryptSync}=require('node:crypto'); const s=randomBytes(16); const h=scryptSync(process.argv[1],s,32,{N:16384,r:8,p:1,maxmem:33554432}); console.log(['scrypt-v1',16384,8,1,s.toString('base64url'),h.toString('base64url')].join('$'))" 'choose-a-local-password'
ADMIN_PASSWORD_HASH=

# DB / Redis (compose 내부 서비스명)
POSTGRES_USER=auth_svc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_db
DATABASE_URL=postgres://auth_svc:change-me@postgres:5432/auth_db
REDIS_URL=redis://redis:6379

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OIDC (심사 전 scope=openid만)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 운영 안전장치
TUNNEL_ORIGIN=
CSRF_TOKEN_SALT=change-me-random-32-bytes

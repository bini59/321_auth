# 서버
PORT=3000
AUTH_ORIGIN=https://auth.bini59.dev
COOKIE_DOMAIN=.bini59.dev
STATIC_ORIGIN=https://static.bini59.dev
PROFILE_STORAGE_DIR=/var/lib/321-auth/profile
SESSION_TTL_SECONDS=1209600
ADMIN_SESSION_TTL_SECONDS=28800

# DB: SQLite 파일 하나 (compose 는 authdata 볼륨의 /var/lib/321-auth/data/auth.db 를 쓴다)
# 로컬 개발: DATABASE_PATH=./tmp/auth.db
DATABASE_PATH=/var/lib/321-auth/data/auth.db

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OIDC (심사 전 scope=openid만)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 운영 안전장치
TUNNEL_ORIGIN=
CSRF_TOKEN_SALT=change-me-random-32-bytes

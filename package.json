{
  "name": "321_auth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "nanoid@3": "3.3.18"
    }
  },
  "scripts": {
    "build": "pnpm --filter @321-auth/api build && pnpm --filter @321-auth/admin build",
    "build:api": "pnpm --filter @321-auth/api build",
    "build:admin": "pnpm --filter @321-auth/admin build",
    "migrate": "pnpm --filter @321-auth/api migrate",
    "seed": "pnpm --filter @321-auth/api seed",
    "e2e": "pnpm build:api && pnpm --filter @321-auth/api exec playwright test --config ../../playwright.config.ts",
    "dev:api": "pnpm --filter @321-auth/api start:dev",
    "dev:admin": "pnpm --filter @321-auth/admin dev",
    "test": "pnpm --filter @321-auth/api test",
    "typecheck": "pnpm --filter @321-auth/api typecheck && pnpm --filter @321-auth/admin typecheck"
  }
}
